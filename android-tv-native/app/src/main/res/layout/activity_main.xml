<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0b"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Logo / Icon -->
        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/ic_tv_off" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-light"
            android:text="Desh-IT Dash"
            android:textColor="#ffffff"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSearchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Searching for server..."
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textServerFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:drawableStart="@drawable/dot_online"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Server found"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Code Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#16161e"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Enter Pairing Code"
                android:textColor="#ffffff"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/editCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="#1e1e2e"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:hint="000000"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:letterSpacing="0.3"
                android:maxLength="6"
                android:textColor="#ffffff"
                android:textColorHint="#444444"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Manual IP entry — shown when auto-discovery fails -->
            <LinearLayout
                android:id="@+id/manualIpContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Server IP (from ipconfig on PC)"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editManualIp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#1e1e2e"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:hint="192.168.12.106"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="#ffffff"
                    android:textColorHint="#444444"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPair"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#3b82f6"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:fontFamily="sans-serif-medium"
                android:text="Confirm Pairing"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="16sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="#3b82f6"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#ef4444"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
